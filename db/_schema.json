{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "nk-db series",
 "type": "object",
 "oneOf": [
  {
   "$ref": "#/$defs/table"
  },
  {
   "$ref": "#/$defs/model"
  }
 ],
 "$defs": {
  "common": {
   "type": "object",
   "required": [
    "id",
    "source",
    "pol",
    "unit",
    "source_file",
    "sha1",
    "processing"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "source": {
     "type": "string"
    },
    "pol": {
     "type": "string"
    },
    "unit": {
     "const": "nm"
    },
    "source_file": {
     "type": "string"
    },
    "sha1": {
     "type": [
      "string",
      "null"
     ]
    },
    "processing": {
     "type": "object"
    }
   }
  },
  "table": {
   "allOf": [
    {
     "$ref": "#/$defs/common"
    },
    {
     "type": "object",
     "required": [
      "kind",
      "range_nm",
      "points",
      "data"
     ],
     "properties": {
      "kind": {
       "const": "table"
      },
      "range_nm": {
       "type": "array",
       "minItems": 2,
       "maxItems": 2,
       "items": {
        "type": "number"
       },
       "description": "wl_min, wl_max in nm, ascending"
      },
      "points": {
       "type": "integer",
       "minimum": 1
      },
      "quality": {
       "type": "object",
       "required": [
        "status",
        "rows_dropped",
        "unit_conflict",
        "extreme_values"
       ],
       "properties": {
        "status": {
         "enum": [
          "ok",
          "suspect"
         ]
        },
        "rows_dropped": {
         "type": "integer",
         "minimum": 0
        },
        "unit_conflict": {
         "type": "boolean"
        },
        "extreme_values": {
         "type": "boolean"
        }
       }
      },
      "data": {
       "type": "object",
       "required": [
        "wl",
        "n",
        "k"
       ],
       "properties": {
        "wl": {
         "type": "array",
         "items": {
          "type": "number"
         }
        },
        "n": {
         "type": "array",
         "items": {
          "type": "number"
         }
        },
        "k": {
         "type": "array",
         "items": {
          "type": "number"
         }
        }
       }
      }
     }
    }
   ]
  },
  "model": {
   "allOf": [
    {
     "$ref": "#/$defs/common"
    },
    {
     "type": "object",
     "required": [
      "kind",
      "model"
     ],
     "properties": {
      "kind": {
       "const": "sellmeier"
      },
      "model": {
       "type": "object",
       "required": [
        "formula",
        "terms"
       ],
       "properties": {
        "formula": {
         "type": "string"
        },
        "terms": {
         "type": "array",
         "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
           "type": "number"
          }
         }
        }
       }
      },
      "range_nm": {
       "type": "null"
      },
      "points": {
       "type": "null"
      }
     }
    }
   ]
  }
 }
}